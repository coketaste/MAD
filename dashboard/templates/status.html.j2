{% extends "base.html.j2" %}
{% macro mark(on, what) -%}
{% if on %}<span class="yes" aria-hidden="true">✓</span><span class="sr">{{ what }}: yes</span>{% else %}<span class="no" aria-hidden="true">–</span><span class="sr">{{ what }}: no</span>{% endif %}
{%- endmacro %}
{% macro status_badge(value) -%}
{% set kind = {"in-progress": "good", "planned": "warning", "blocked": "critical"}.get(value, "") %}
<span class="status {{ kind }}">{{ value }}</span>
{%- endmacro %}
{% set live = snap.state == "live" %}
{% set heading = ("MAD status — " ~ snap.release ~ " (in progress)") if live else ("MAD status — " ~ snap.version) %}
{% block title %}{{ heading }}{% endblock %}
{% block style %}
  header.page { padding: 36px 0 4px; }
  header.page h1 { font-size: 32px; line-height: 1.15; margin: 0 0 6px; letter-spacing: -0.02em; }
  header.page .meta { color: var(--ink-2); font-size: 14px; }
  .banner { margin: 16px 0 0; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--critical); }
  .banner strong { color: var(--critical); }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 24px 0 8px; }
  .kpi { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .kpi .value { font-size: 30px; font-weight: 650; line-height: 1.2; margin-top: 4px; }
  .kpi .sub { color: var(--ink-3); font-size: 12.5px; margin-top: 2px; }
  .toc { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 18px 0 0; padding: 0; list-style: none; font-size: 14px; }
  section { margin: 44px 0; }
  section > h2 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
  section > .lede { color: var(--ink-2); margin: 0 0 16px; max-width: 880px; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 20px 0 12px; }
  .filters input, .filters select { font: 14px var(--sans); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; }
  .filters input { min-width: 260px; }
  .filters .count { color: var(--ink-3); font-size: 13px; }
  details.fw { border: 1px solid var(--line); border-radius: 10px; margin: 0 0 10px; }
  details.fw > summary { cursor: pointer; padding: 11px 14px; font-weight: 600; display: flex; gap: 10px; align-items: baseline; list-style: none; }
  details.fw > summary::-webkit-details-marker { display: none; }
  details.fw > summary::before { content: "›"; color: var(--ink-3); transition: transform .1s; }
  details.fw[open] > summary::before { transform: rotate(90deg); }
  details.fw > summary .muted { font-weight: 400; font-size: 13px; }
  details.fw .card { border: 0; border-top: 1px solid var(--line); border-radius: 0 0 10px 10px; }
  .qa { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; }
  .qa h3 { font-size: 15px; margin: 0; padding: 12px 14px; border-bottom: 1px solid var(--line); }
  .qa ul { list-style: none; margin: 0; padding: 0; }
  .qa li { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .qa li:last-child { border-bottom: 0; }
  .qa .area { font-weight: 600; }
  .qa .scope { color: var(--ink-2); font-size: 13.5px; }
  .qa .note { color: var(--ink-3); font-size: 13px; }
  .skugrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0 0 16px; }
  .sku { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .sku .name { font-weight: 650; font-size: 17px; }
  .sku .isa { color: var(--ink-3); font: 12px var(--mono); margin-bottom: 6px; }
  .empty { padding: 18px 14px; color: var(--ink-2); }
  .warnings { margin-top: 16px; font-size: 13.5px; color: var(--ink-2); }
  .warnings summary { cursor: pointer; }
  .warnings li { margin: 3px 0; }
{% endblock %}
{% block body %}
<main class="wrap">
<header class="page">
  <h1>{{ heading }}</h1>
  <div class="meta">
    {% if live %}Live view of <code>develop</code>{% else %}Frozen release snapshot{% endif %}
    {% if snap.commit %} at <a href="https://github.com/ROCm/MAD/tree/{{ snap.commit }}"><code>{{ snap.commit[:10] }}</code></a>{% endif %}
    · generated {{ snap.date }} · <a href="{{ root }}/status/releases.html">All releases</a>
  </div>
  {% if snap.internal %}
  <div class="banner" role="alert"><strong>Internal build.</strong> This page includes the internal roadmap from <code>dashboard/roadmap.internal.yaml</code>. Do not publish or forward outside AMD.</div>
  {% endif %}
  {% set ci_covered = view.ci_skus.values() | select | list | length %}
  <div class="kpis">
    <div class="kpi"><div class="label">Supported models</div><div class="value">{{ snap.models | length }}</div><div class="sub">registered in madengine</div></div>
    <div class="kpi"><div class="label">Frameworks</div><div class="value">{{ view.groups | length }}</div><div class="sub">{{ view.groups | map(attribute="workload") | unique | join(" · ") }}</div></div>
    <div class="kpi"><div class="label">Base images</div><div class="value">{{ snap.images | length }}</div><div class="sub">{{ snap.images | map(attribute="rocm") | unique | list | length }} distinct ROCm versions</div></div>
    <div class="kpi"><div class="label">GPU products with CI</div><div class="value">{{ ci_covered }} of {{ snap.skus | length }}</div><div class="sub">{{ snap.skus | join(" · ") }}</div></div>
    <div class="kpi"><div class="label">Public roadmap items</div><div class="value">{{ snap.roadmap | length }}</div><div class="sub">{% if diff %}{{ diff.added | length }} models added since {{ diff.since }}{% elif live %}no frozen release yet{% else %}first frozen release{% endif %}</div></div>
  </div>
  <ul class="toc">
    <li><a href="#support">1. Model support</a></li>
    <li><a href="#roadmap">2. Oncoming models</a></li>
    <li><a href="#qa">3. QA coverage</a></li>
    <li><a href="#rocm">4. ROCm support matrix</a></li>
    <li><a href="#ci">5. CI coverage</a></li>
    <li><a href="#changes">6. Changes{% if diff %} since {{ diff.since }}{% endif %}</a></li>
  </ul>
  {% if snap.warnings %}
  <details class="warnings">
    <summary>Data gaps ({{ snap.warnings | length }}) — fix in <code>dashboard/status.yaml</code></summary>
    <ul>{% for w in snap.warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </details>
  {% endif %}
</header>

<section id="support">
  <h2>1. Current public model support</h2>
  <p class="lede">Every model below can be run with <code>madengine run --tags &lt;tag&gt;</code>. GPU columns show where madengine will run the model
    (gfx942 = MI300X/MI325X, gfx950 = MI350X/MI355X, minus <code>skip_gpu_arch</code>); for what is actually exercised in CI see section 5.</p>
  <div class="card">
    <table>
      <thead><tr>
        <th>Framework</th><th>Workload</th><th class="num">Models</th>
        {% for sku in snap.skus %}<th class="num">{{ sku }}</th>{% endfor %}
        <th>ROCm</th>
      </tr></thead>
      <tbody>
      {% for g in view.groups %}
        <tr>
          <td><a href="#fw-{{ loop.index }}">{{ g.name }}</a></td>
          <td>{{ g.workload }}</td>
          <td class="num">{{ g.models | length }}</td>
          {% for sku in snap.skus %}<td class="num{% if not g.sku_counts[sku] %} muted{% endif %}">{{ g.sku_counts[sku] or "–" }}</td>{% endfor %}
          <td>{{ g.rocm | join(", ") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="filters" role="search">
    <input id="q" type="search" placeholder="Filter models, tags, precision…" aria-label="Filter models">
    <select id="sku" aria-label="GPU product">
      <option value="">All GPU products</option>
      {% for sku in snap.skus %}<option value="{{ sku }}">{{ sku }}</option>{% endfor %}
    </select>
    <select id="workload" aria-label="Workload">
      <option value="">All workloads</option>
      {% for w in view.groups | map(attribute="workload") | unique %}<option value="{{ w }}">{{ w }}</option>{% endfor %}
    </select>
    <span class="count" id="count" aria-live="polite"></span>
  </div>

  {% for g in view.groups %}
  <details class="fw" id="fw-{{ loop.index }}" data-workload="{{ g.workload }}">
    <summary>{{ g.name }} <span class="muted"><span class="n">{{ g.models | length }}</span> model{{ "s" if g.models | length != 1 }} · {{ g.workload }}</span></summary>
    <div class="card">
      <table>
        <thead><tr>
          <th>Model</th><th>Precision</th>
          {% for sku in snap.skus %}<th class="mark">{{ sku }}</th>{% endfor %}
          <th class="num">GPUs</th><th class="num">Nodes</th><th>Suites</th><th>madengine tag</th>
        </tr></thead>
        <tbody>
        {% for m in g.models %}
          <tr data-skus="{{ m.skus | join(' ') }}" data-search="{{ [m.model, m.hf_repo or '', m.name, m.precision, m.suites | join(' '), g.name] | join(' ') | lower }}">
            <td>{% if m.hf_repo %}<a href="https://huggingface.co/{{ m.hf_repo }}">{{ m.model }}</a>{% else %}{{ m.model }}{% endif %}</td>
            <td>{{ m.precision or "–" }}</td>
            {% for sku in snap.skus %}<td class="mark">{{ mark(sku in m.skus, sku) }}</td>{% endfor %}
            <td class="num">{{ m.n_gpus }}</td>
            <td class="num">{{ m.nodes }}</td>
            <td>{% for s in m.suites %}<span class="chip" title="{{ snap.suite_tags[s] }}">{{ s }}</span>{% endfor %}</td>
            <td>{% if live and m.page is defined %}<a href="{{ root }}/models/{{ m.page }}/index.html"><code>{{ m.name }}</code></a>{% else %}<code>{{ m.name }}</code>{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {% endfor %}
  {% set partial = snap.registries | selectattr("note") | list %}
  {% if partial %}
  <p class="muted">Incomplete registries: {% for r in partial %}<code>scripts/{{ r.dir }}</code> ({{ r.note }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
  {% endif %}
  <details class="warnings">
    <summary>Suite tag legend</summary>
    <ul>{% for tag, label in snap.suite_tags.items() %}<li><span class="chip">{{ tag }}</span> {{ label }}</li>{% endfor %}</ul>
  </details>
</section>

<section id="roadmap">
  <h2>2. Oncoming model plan</h2>
  <p class="lede">Models planned for upcoming MAD releases. Only items cleared for public disclosure are listed{% if snap.internal %}; rows marked <em>internal</em> come from the internal roadmap{% endif %}.</p>
  <div class="card">
  {% if snap.roadmap %}
    <table>
      <thead><tr><th>Model</th><th>Framework</th><th>Target release</th><th>GPU products</th><th>Status</th><th>Notes</th></tr></thead>
      <tbody>
      {% for r in snap.roadmap %}
        <tr>
          <td>{{ r.model }}{% if r.internal | default(false) %} <span class="chip">internal</span>{% endif %}</td>
          <td>{{ r.framework | default("–") }}</td>
          <td>{{ r.target | default("–") }}</td>
          <td>{{ (r.skus | default([])) | join(", ") or "–" }}</td>
          <td>{{ status_badge(r.status | default("planned")) }}</td>
          <td class="muted">{{ r.note | default("") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty">No public roadmap items for this release.</div>
  {% endif %}
  </div>
</section>

<section id="qa">
  <h2>3. QA coverage</h2>
  <p class="lede">What a MAD run verifies today, and what it does not.</p>
  <div class="qa">
    <div class="card">
      <h3><span class="status good">Covered</span></h3>
      <ul>{% for q in snap.qa.covered %}
        <li><div class="area">{{ q.area }}</div><div class="scope">{{ q.scope }}</div>{% if q.note | default("") %}<div class="note">{{ q.note }}</div>{% endif %}</li>
      {% endfor %}</ul>
    </div>
    <div class="card">
      <h3><span class="status critical">Not covered</span></h3>
      {% if snap.qa.not_covered %}
      <ul>{% for q in snap.qa.not_covered %}
        <li><div class="area">{{ q.area }}</div><div class="scope">{{ q.scope }}</div>{% if q.note | default("") %}<div class="note">{{ q.note }}</div>{% endif %}</li>
      {% endfor %}</ul>
      {% else %}<div class="empty">Nothing recorded.</div>{% endif %}
    </div>
  </div>
</section>

<section id="rocm">
  <h2>4. ROCm support matrix</h2>
  <p class="lede">Base image and ROCm version each framework is validated against, and the GPU products its models are registered for.
    “floating” means the Dockerfile builds from an unpinned <code>:latest</code> tag.</p>
  <div class="card">
    <table>
      <thead><tr>
        <th>Framework</th><th>Base image</th><th>ROCm</th>
        {% for sku in snap.skus %}<th class="mark">{{ sku }}</th>{% endfor %}
        <th class="num">Models</th><th>Dockerfile</th>
      </tr></thead>
      <tbody>
      {% for i in snap.images %}
        <tr>
          <td>{{ i.frameworks | join(", ") }}</td>
          <td><code>{{ i.image or "?" }}</code></td>
          <td>{% if i.rocm == "unknown" %}<span class="status warning">unknown</span>{% else %}{{ i.rocm }}{% endif %}<div class="muted" style="font-size:12px">{{ i.rocm_source }}</div></td>
          {% for sku in snap.skus %}<td class="mark">{{ mark(sku in i.skus, sku) }}</td>{% endfor %}
          <td class="num">{{ i.models }}</td>
          <td>{% if i.path %}<a href="https://github.com/ROCm/MAD/blob/{{ snap.commit or 'develop' }}/{{ i.path }}" title="{{ i.path }}"><code style="white-space:nowrap;overflow-wrap:normal">{{ i.dockerfile }}</code></a>{% else %}<code>{{ i.dockerfile }}</code>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section id="ci">
  <h2>5. CI coverage by architecture</h2>
  <p class="lede">GPU products with recurring CI, and every CI job that runs MAD models.</p>
  <div class="skugrid">
  {% for sku in snap.skus %}
    <div class="sku">
      <div class="name">{{ sku }}</div>
      <div class="isa">{{ view.sku_isa[sku] }}</div>
      {% if view.ci_skus[sku] %}
        <span class="status good">CI</span>
        <div class="muted" style="font-size:12.5px">{{ view.ci_skus[sku] | map(attribute="cadence") | unique | join(", ") }}</div>
      {% else %}
        <span class="status critical">No CI recorded</span>
      {% endif %}
    </div>
  {% endfor %}
  </div>
  <div class="card">
  {% if snap.ci %}
    <table>
      <thead><tr><th>Job</th>{% for sku in snap.skus %}<th class="mark">{{ sku }}</th>{% endfor %}<th>Cadence</th><th>Scope</th><th>Runner</th></tr></thead>
      <tbody>
      {% for c in snap.ci %}
        <tr>
          <td>{{ c.name }}</td>
          {% for sku in snap.skus %}<td class="mark">{{ mark(sku in (c.skus | default([], true)), sku) }}</td>{% endfor %}
          <td>{{ c.cadence | default("–") }}</td>
          <td>{% for s in c.suites | default([]) %}<span class="chip">{{ s }}</span>{% endfor %}</td>
          <td class="muted">{{ c.runner | default("") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty">No CI jobs recorded.</div>
  {% endif %}
  </div>
</section>

<section id="changes">
  <h2>6. Changes{% if diff %} since {{ diff.since }}{% endif %}</h2>
  {% if not diff %}
  <p class="lede">{% if live %}No release has been frozen yet, so there is nothing to compare with. Freeze one with <code>tools/dashboard/build.py --freeze {{ snap.release }}</code>.{% else %}This is the first frozen release; there is no earlier snapshot to compare with.{% endif %}</p>
  {% else %}
  <p class="lede">{{ diff.added | length }} added, {{ diff.removed | length }} removed, {{ diff.image_changes | length }} base image changes.</p>
  <div class="qa">
    <div class="card">
      <h3>Added ({{ diff.added | length }})</h3>
      {% if diff.added %}<ul>{% for m in diff.added %}<li><div class="area">{{ m.model }}</div><div class="scope">{{ m.framework }} · <code>{{ m.name }}</code></div></li>{% endfor %}</ul>
      {% else %}<div class="empty">None.</div>{% endif %}
    </div>
    <div class="card">
      <h3>Removed ({{ diff.removed | length }})</h3>
      {% if diff.removed %}<ul>{% for m in diff.removed %}<li><div class="area">{{ m.model }}</div><div class="scope">{{ m.framework }} · <code>{{ m.name }}</code></div></li>{% endfor %}</ul>
      {% else %}<div class="empty">None.</div>{% endif %}
    </div>
  </div>
  {% if diff.image_changes %}
  <div class="card" style="margin-top:16px">
    <table>
      <thead><tr><th>Framework</th><th>Base image</th><th>ROCm</th></tr></thead>
      <tbody>{% for c in diff.image_changes %}
        <tr><td>{{ c.frameworks | join(", ") }}</td><td><code>{{ c.from_image }}</code> → <code>{{ c.to_image }}</code></td><td>{{ c.from_rocm }} → {{ c.to_rocm }}</td></tr>
      {% endfor %}</tbody>
    </table>
  </div>
  {% endif %}
  {% endif %}
</section>
</main>
{% endblock %}

{% block scripts %}
<script>
  // Model filter: one row scoping every framework table below it.
  (function () {
    var q = document.getElementById("q"), sku = document.getElementById("sku"), wl = document.getElementById("workload");
    var count = document.getElementById("count"), groups = document.querySelectorAll("details.fw");
    function apply() {
      var text = q.value.trim().toLowerCase(), product = sku.value, workload = wl.value, total = 0, filtering = text || product || workload;
      groups.forEach(function (g) {
        var shown = 0;
        g.querySelectorAll("tbody tr").forEach(function (tr) {
          var ok = (!workload || g.dataset.workload === workload)
            && (!product || tr.dataset.skus.split(" ").indexOf(product) >= 0)
            && (!text || tr.dataset.search.indexOf(text) >= 0);
          tr.hidden = !ok;
          if (ok) shown++;
        });
        g.hidden = shown === 0;
        g.querySelector(".n").textContent = shown;
        if (filtering) g.open = shown > 0 && shown <= 60;
        total += shown;
      });
      count.textContent = filtering ? total + " matching models" : "";
    }
    [q, sku, wl].forEach(function (el) { el.addEventListener("input", apply); });
  })();
</script>
{% endblock %}
