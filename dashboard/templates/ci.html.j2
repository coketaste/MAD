{% extends "base.html.j2" %}
{% import "macros.html.j2" as ui with context %}
{% block title %}CI coverage — MAD Recipes{% endblock %}
{% block style %}
  .skugrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 0 0 16px; }
  .sku .name { font-weight: 650; font-size: 17px; }
  .sku .name .ico { color: var(--brand); }
  .sku .isa { color: var(--ink-3); font: 12px var(--mono); margin-bottom: 6px; }
{% endblock %}
{% block body %}
<main class="wrap">
  {{ ui.page_header("CI coverage by architecture", "GPU products with recurring CI, and every CI job that runs MAD models.", snap, glyph="server") }}
  <section>
    <div class="skugrid">
    {% for sku in snap.skus %}
      <div class="tile sku">
        <div class="name with-ico">{{ icons.glyph("chip", 20) }}{{ sku }}</div>
        <div class="isa">{{ view.sku_isa[sku] }}</div>
        {% if view.ci_skus[sku] %}
          <span class="status good">CI</span>
          <div class="faint" style="font-size:12.5px">{{ view.ci_skus[sku] | map(attribute="cadence") | unique | join(", ") }}</div>
        {% else %}
          <span class="status critical">No CI recorded</span>
        {% endif %}
      </div>
    {% endfor %}
    </div>
    <div class="card">
    {% if snap.ci %}
      <table>
        <thead><tr><th>Job</th>{% for sku in snap.skus %}<th class="mark">{{ sku }}</th>{% endfor %}<th>Cadence</th><th>Scope</th><th>Runner</th></tr></thead>
        <tbody>
        {% for c in snap.ci %}
          <tr>
            <td>{{ c.name }}</td>
            {% for sku in snap.skus %}<td class="mark">{{ ui.mark(sku in (c.skus | default([], true)), sku) }}</td>{% endfor %}
            <td>{{ c.cadence | default("–") }}</td>
            <td>{% for s in c.suites | default([]) %}<span class="chip">{{ s }}</span>{% endfor %}</td>
            <td class="muted">{{ c.runner | default("") }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">No CI jobs recorded.</div>
    {% endif %}
    </div>
    <p class="faint" style="font-size:12.5px">GPU CI runs outside GitHub; this list is maintained in <code>dashboard/status.yaml</code>.</p>
  </section>
</main>
{% endblock %}
