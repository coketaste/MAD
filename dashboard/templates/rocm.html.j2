{% extends "base.html.j2" %}
{% import "macros.html.j2" as ui %}
{% block title %}ROCm support matrix — MAD Recipes{% endblock %}
{% block body %}
<main class="wrap">
  {{ ui.page_header("ROCm support matrix", "The base image and ROCm version each framework is benchmarked on, and the GPU products its models are registered for. “floating” means the Dockerfile builds from an unpinned :latest tag.", snap) }}
  <section>
    <div class="card">
      <table>
        <thead><tr>
          <th>Framework</th><th>Base image</th><th>ROCm</th>
          {% for sku in snap.skus %}<th class="mark">{{ sku }}</th>{% endfor %}
          <th class="num">Configs</th><th>Dockerfile</th>
        </tr></thead>
        <tbody>
        {% for i in snap.images %}
          <tr>
            <td>{% for name in i.frameworks %}{% if name in fw_slugs %}<a href="{{ root }}/models/index.html?fw={{ fw_slugs[name] }}">{{ name }}</a>{% else %}{{ name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</td>
            <td><code>{{ i.image or "?" }}</code></td>
            <td>{% if i.rocm == "unknown" %}<span class="status warning">unknown</span>{% else %}{{ i.rocm }}{% endif %}<div class="faint" style="font-size:12px">{{ i.rocm_source }}</div></td>
            {% for sku in snap.skus %}<td class="mark">{{ ui.mark(sku in i.skus, sku) }}</td>{% endfor %}
            <td class="num">{{ i.models }}</td>
            <td>{% if i.path %}<a href="https://github.com/ROCm/MAD/blob/{{ snap.commit or 'develop' }}/{{ i.path }}" title="{{ i.path }}"><code style="white-space:nowrap;overflow-wrap:normal">{{ i.dockerfile }}</code></a>{% else %}<code>{{ i.dockerfile }}</code>{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="faint" style="font-size:12.5px">ROCm versions come from the image tag where it encodes one, otherwise from <code>rocm_overrides</code> in <code>dashboard/status.yaml</code>.</p>
  </section>
</main>
{% endblock %}
